{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://polar-61ps.onrender.com/api/:match*"
    },
    {
      "source": "/docs",
      "destination": "https://polar-61ps.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://polar-61ps.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
